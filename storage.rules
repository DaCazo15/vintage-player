rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny read/write access to all files by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow read/write access only to an authenticated user's own audio folder
    match /users/{uid}/audio/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Allow read/write access only to an authenticated user's own cover art folder
    match /users/{uid}/covers/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
